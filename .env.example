# 用户与外部转换器都能访问的本站地址，不包含 /api/v1。公网部署必须填写实际 HTTPS 域名。
SUB_FORGE_PUBLIC_BASE_URL=https://sub.example.com

# 程序监听的地址和端口；只允许本机访问时使用 127.0.0.1:8080。
SUB_FORGE_LISTEN_ADDR=0.0.0.0:8080

# 留空公开使用；设置后所有 /api/* 请求都需要访问 token，/health 不受影响。
# 使用 32 至 256 个可打印 ASCII 字符，不含空白；可运行 openssl rand -hex 32 生成。
SUB_FORGE_ACCESS_TOKEN=

# 只信任明确配置的反向代理 CIDR，不默认信任客户端提交的转发头。
TRUSTED_PROXY_CIDRS=
REQUESTS_PER_MINUTE=60
CONVERSION_CONCURRENCY=4
FETCH_CONCURRENCY=16
SUB_FORGE_TIMEOUT_SECS=60
SUB_FORGE_RULES_TIMEOUT_SECS=30
MAX_GENERATED_CONFIG_BYTES=20971520
MAX_SUBSCRIPTION_BYTES=10485760
MAX_ACL4SSR_CONFIG_BYTES=2097152
SCRIPT_TIMEOUT_MS=2000
SCRIPT_MEMORY_BYTES=134217728
SCRIPT_MAX_BYTES=1048576
SCRIPT_CONCURRENCY=4

# 浏览器直接调用 API 时填写允许的前端来源，多个地址用逗号分隔。
# 留空禁用跨域访问；只允许明确的 HTTP(S) 来源，不接受通配符。
SUB_FORGE_ALLOWED_ORIGINS=
